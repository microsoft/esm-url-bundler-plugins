{
  "name": "@vscode/esm-url-webpack-plugin",
  "version": "1.0.0",
  "description": "Webpack 5 plugin for handling ?esm URL imports",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/esm-url-bundler-plugins.git",
    "directory": "packages/webpack"
  },
  "homepage": "https://github.com/microsoft/esm-url-bundler-plugins/tree/main/packages/webpack#readme",
  "bugs": {
    "url": "https://github.com/microsoft/esm-url-bundler-plugins/issues"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@vscode/esm-url-plugin-common": "*",
    "rollup": "^4.59.0"
  },
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "license": "MIT"
}
